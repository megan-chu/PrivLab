# PrivLab settings. Copy this file to .env and fill in the 2 API keys marked FILL IN. Leave the rest as is.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# .env is gitignored: never commit real keys.
# A missing key never crashes PrivLab and never sends anything; the step that needs it says so.

# --- Local secrets: generate with the command shown, paste the output after the "=" ---
# Seal key (proves text was masked before it reaches an AI):
#   python -c "import secrets; print(secrets.token_hex(32))"
PRIVLAB_SEAL_KEY=
# Vault key (encrypts the vault, learned names and cache):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRIVLAB_VAULT_KEY=
# If you leave either empty, PrivLab generates it on first start and saves it here.

# --- Meta Model API: Muse Spark 1.3 (FILL IN; field definitions and extraction) ---
# Without it: de-identification still works; adding fields and extraction ask for the key.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# --- Baseten: Muse Spark Open (FILL IN; the second name check, on masked text only) ---
# Without it: de-identification still works; the second check is marked "review manually".
# To host the model in-house, change only the URL and model.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# --- Optional: Baseten decision model, a second opinion on values and undecided name words ---
# Needs its own Baseten key. Leave empty (or set PRIVLAB_SECOND_OPINION=off) to skip; you are asked as usual.
BASETEN_DECISION_API_KEY=
BASETEN_DECISION_MODEL=decision-models/baseten-elephant-9b-latest
PRIVLAB_SECOND_OPINION=on

# --- Local name model (spaCy, installed by requirements.txt). Leave as is. ---
PRIVLAB_NER_MODEL=en_core_web_sm
