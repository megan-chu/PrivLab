# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Meta Model API (Muse Spark 1.3, standard variant; never -contributor) ---
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# --- Baseten (Muse Spark Open, open weights; hackathon key works only with this exact model id) ---
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# --- Local secrets ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
PRIVLAB_SEAL_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRIVLAB_VAULT_KEY=

# --- Local name model (spaCy, runs on this device). "off" disables it. ---
# Install: python -m pip install -r requirements.txt
PRIVLAB_NER_MODEL=en_core_web_sm
