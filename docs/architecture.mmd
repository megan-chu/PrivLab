flowchart LR
    U(["Healthcare professional"])

    subgraph CLIENT["AI assistant or report viewer"]
        Q["Ask: 'What's the histology and grade?'"]
        R["Review: evidence highlighted,\namber fields to confirm"]
    end

    subgraph MCP["PrivLab MCP server"]
        direction TB
        subgraph HOSP["De-identification: ask, confirm, highlight, correct, apply"]
            RULES["Presidio patterns (laptop)\nIDs, phones, dates, emails"]
            GLIM["Muse Spark 1.3\nnames and free-text identifiers\non already-masked text"]
            SUR["Consistent surrogates\n[PATIENT-A], [DATE-2]"]
            VAULT[("Encrypted vault\nre-link key")]
        end
        REC["find_candidates\nMuse Spark 1.3\nde-identified text only"]
        VAL["Two checks in code\nevidence exists, value type ok\nthen rank, amber if unsure"]
        PACKS[("Knowledge pack\nstarts empty, grows from\nuser confirmations")]
        TEACH["confirm_field\nlearn examples, readiness"]
    end

    OUT[("Structured data\nregistry, research, trials")]

    U --> Q
    Q -->|"raw report"| RULES
    RULES --> GLIM --> SUR
    SUR -.-> VAULT
    SUR -->|"de-identified text"| REC
    PACKS --> REC
    REC --> VAL --> R
    R -->|"confirm"| OUT
    R -->|"correct or teach a term"| TEACH
    TEACH --> PACKS

    classDef safe fill:#ECFDF5,stroke:#059669,color:#065F46
    classDef cloud fill:#EFF6FF,stroke:#2563EB,color:#1E3A8A
    classDef know fill:#FFFBEB,stroke:#B45309,color:#92400E
    class RULES,SUR,VAULT safe
    class GLIM cloud
    class REC,VAL cloud
    class PACKS,TEACH know
