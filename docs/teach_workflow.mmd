flowchart LR
    A(["User: New field<br/>'tumour size'<br/>(pack starts empty)"]) --> P1

    subgraph P1["1 · Define (a conversation beside the report)"]
        direction TB
        C["Muse Spark asks:<br/>'Did you mean: largest tumour dimension<br/>on the surgical specimen?'<br/>number, cm, 0.1 to 30"]
        D{"Yes, or Not quite?"}
        E["Not quite: user explains<br/>in own words; it asks again<br/>(only the field name and the<br/>user's words are sent)"]
        C --> D
        D -->|"Not quite"| E --> C
    end

    subgraph P2["2 · Check on the open report"]
        direction TB
        F["Field saved; PrivLab reads it<br/>from the open report and<br/>highlights the quote"]
        G{"'Is this what you mean?'"}
        F --> G
    end

    subgraph P3["3 · Use on every report"]
        direction TB
        R["All fields in one call;<br/>every value highlighted in colour,<br/>with its quote and reason"]
        V["Five checks in code<br/>quote in report, valid value,<br/>value in quote, section, no identifiers"]
        S{"Result"}
        GR["Verified: confirm in one click"]
        AM["Needs review or Refused:<br/>pick a candidate, or select<br/>the right text and Use as"]
        NF["Not found: select it in the report,<br/>or confirm it is not stated"]
        R --> V --> S
        S -->|"All checks pass"| GR
        S -->|"Unsure or a check failed"| AM
        S -->|"Nothing found"| NF
    end

    D -->|"Yes"| F
    G -->|"No: refine"| E
    G -->|"Yes: confirmed, learned"| R
    GR --> OUT(["Approve and next report<br/>registry .csv"])
    AM -->|"answer becomes an example"| R
    NF -->|"answer becomes an example"| R

    NOTE["Field readiness: New → Learning → Ready<br/>(Ready = 4 of the last 5 accepted unchanged)"]
    P3 ~~~ NOTE

    classDef user fill:#EEF2F7,stroke:#1E3A5F,color:#111827
    classDef ai fill:#EFF6FF,stroke:#2563EB,color:#1E3A8A
    classDef good fill:#ECFDF5,stroke:#059669,color:#065F46
    classDef warn fill:#FFFBEB,stroke:#B45309,color:#92400E
    classDef note fill:#FFFFFF,stroke:#9CA3AF,color:#374151,stroke-dasharray: 4 3
    class A,E user
    class C,F,R,V ai
    class GR,OUT good
    class AM,NF warn
    class NOTE note
